{
  // Exemplo: se você já tem um wrangler.toml/jsonc deste Worker, mantenha o seu e só confira
  // "main", o binding ASSETS e "run_worker_first".
  "name": "cartinha-de-natal",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
  // Variáveis (painel do Cloudflare > Worker > Settings > Variables and Secrets):
  //   SUPABASE_URL, SUPABASE_SECRET_KEY (secret), PAGAMENTO_WEBHOOK_SECRET (secret)
  // NÃO crie AMBIENTE em produção.
}
